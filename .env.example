# ─────────────────────────────────────────────────────────────
# Lama Hotel & Lodge — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase / Neon / local).
# For Supabase/Neon use the *pooled* URL here and the direct URL below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Direct (non-pooled) connection used by Prisma migrations. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth.js secret — generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required when NOT hosted on Vercel (e.g. `npm start` on your own server).
# AUTH_TRUST_HOST=true

# Used ONLY by `npm run db:seed` to create the first admin account.
# Password must be at least 12 characters. Remove from the environment after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public URL of the website (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Image storage — Cloudinary (required in production on Vercel).
# If not set, uploads are stored on the local disk in ./uploads (development / self-hosting only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Owner notifications (optional) ─────────────────────────────
# Who receives them (email address) and the on/off switch are set in Admin → Settings.
# Only the SENDING credentials live here. Inquiries are always saved even if sending fails.

# Email via Gmail: create an App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=""            # e.g. yourhotel@gmail.com
SMTP_PASS=""            # the 16-character App Password (NOT your normal Gmail password)
# SMTP_HOST="smtp.gmail.com"   # defaults to Gmail
# SMTP_PORT="465"
# EMAIL_FROM="Lama Hotel & Lodge <yourhotel@gmail.com>"   # optional display name

# ── Spam protection: Cloudflare Turnstile (free) — booking & contact forms ─────
# dash.cloudflare.com → Turnstile → Add widget → hostname: your domain (and localhost for testing).
# Leave both empty to switch it off (the honeypot + rate limits still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
