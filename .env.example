# ─────────────────────────────────────────────────────────────
# Hotel Pine Valley — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase / Neon / local).
# For Supabase/Neon use the *pooled* URL here and the direct URL below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Direct (non-pooled) connection used by Prisma migrations. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth.js secret — generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required when NOT hosted on Vercel (e.g. `npm start` on your own server).
# AUTH_TRUST_HOST=true

# Used ONLY by `npm run db:seed` to create the first admin account.
# Password: at least 6 characters, including a special character. Remove from the environment after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public URL of the website (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Image storage — Cloudinary (required in production on Vercel).
# If not set, uploads are stored on the local disk in ./uploads (development / self-hosting only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Owner notifications (optional) ─────────────────────────────
# Who receives them (email address) and the on/off switch are set in Admin → Settings.
# Only the SENDING credentials live here. Inquiries are always saved even if sending fails.

# Email via Gmail: create an App Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_USER=""            # e.g. yourhotel@gmail.com
SMTP_PASS=""            # the 16-character App Password (NOT your normal Gmail password)
# SMTP_HOST="smtp.gmail.com"   # defaults to Gmail
# SMTP_PORT="465"
# EMAIL_FROM="Hotel Pine Valley <yourhotel@gmail.com>"   # optional display name

# ── Spam protection: Cloudflare Turnstile (free) — booking & contact forms ─────
# dash.cloudflare.com → Turnstile → Add widget → hostname: your domain (and localhost for testing).
# Leave both empty to switch it off (the honeypot + rate limits still apply).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── AI assistant (optional) ────────────────────────────────────
# Powers the admin "Draft reply with AI" helper and the guest chat assistant (bottom-right "Ask us").
# Leave AI_CHAT_ENABLED off or all keys empty and every AI feature hides itself.
# Providers are tried in order: Gemini → Groq → Cloudflare/OpenRouter. Any provider without a key is skipped.
AI_CHAT_ENABLED="false"         # "true" to switch AI features on

# 1. Primary — Google Gemini (free tier). Key: aistudio.google.com → Get API key.
GOOGLE_GENERATIVE_AI_API_KEY=""
# AI_PRIMARY_MODEL="gemini-3.1-flash-lite"

# 2. Fallback 1 — Groq (free tier). Key: console.groq.com → API Keys.
GROQ_API_KEY=""
# AI_FALLBACK1_MODEL="openai/gpt-oss-120b"   # list yours: console.groq.com/docs/models

# 3. Fallback 2 — Cloudflare and/or OpenRouter. Leave AI_FALLBACK2_PROVIDER empty to use every one that has keys
#    (Cloudflare first, then OpenRouter), or set it to "cloudflare" / "openrouter" to use only that one.
# AI_FALLBACK2_PROVIDER="cloudflare"
# AI_FALLBACK2_MODEL=""         # only used when AI_FALLBACK2_PROVIDER is set
                                # cloudflare default: @cf/zai-org/glm-4.7-flash (Llama 3.3 on Cloudflare breaks with tools)
                                # openrouter default: google/gemma-4-31b-it:free (must end in ":free" and support tools —
                                # see openrouter.ai/models?supported_parameters=tools; the free line-up changes often)
# Cloudflare Workers AI: dash.cloudflare.com → account ID in the sidebar; API token from
# My Profile → API Tokens → Create token → "Workers AI" template.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# OpenRouter: openrouter.ai/keys. Only free models (":free") are allowed.
# OPENROUTER_API_KEY=""

# All default models support tool calling. If you pick one that doesn't, list its provider here
# (e.g. "openrouter"): it then answers from the lodge info only and sends bookings to the form.
# AI_NO_TOOLS_PROVIDERS=""
